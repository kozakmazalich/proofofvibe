# ─────────────────────────────────────────────────────────────
#  PROOF OF VIBE — environment variables
#  Copy to .env.local for local dev; add the same keys in Vercel
#  (Project → Settings → Environment Variables, or `vercel env add`).
# ─────────────────────────────────────────────────────────────

# Weir (https://weirapp.io) — third-party X data API with free monthly credits.
# Leave both empty to run on mock data.
WEIR_API_KEY=
# Failover keys: if a key runs out of credits (HTTP 402), is rejected or rate-limited, the next one
# is used automatically. Both vars accept comma-separated lists, e.g. WEIR_API_KEYS=key2,key3.
# A second free Weir account (5 000 credits / month each) keeps the site live when the first is spent.
WEIR_API_KEYS=
# Max posts fetched per search (two searches per scan; 1 credit per post + 1 per call).
WEIR_MAX_POSTS=40

# (Battlegrounds leaderboard is read from the game's public /api/cup/board — nothing to configure.)

# Force mock data even if keys are present: "mock" | "" (auto)
VIBE_DATA_MODE=
