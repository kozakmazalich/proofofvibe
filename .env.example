# ─────────────────────────────────────────────────────────────
#  PROOF OF VIBE — environment variables
#  Copy to .env.local for local dev; add the same keys in Vercel
#  (Project → Settings → Environment Variables, or `vercel env add`).
# ─────────────────────────────────────────────────────────────

# X (Twitter) API v2 Bearer Token — https://developer.x.com
# Leave empty to run on mock data.
X_BEARER_TOKEN=

# "recent" (last 7 days, Basic plan) or "all" (full archive, Pro/Enterprise)
X_SEARCH_SCOPE=recent

# Vibe Vibers Battlegrounds leaderboard endpoint (when available). Leave empty → mock.
BG_LEADERBOARD_API_URL=
BG_API_KEY=

# Force mock data even if tokens are present: "mock" | "" (auto)
VIBE_DATA_MODE=
