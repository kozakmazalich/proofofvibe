# ─────────────────────────────────────────────────────────────
#  PROOF OF VIBE — environment variables
#  Copy to .env.local for local dev; add the same keys in Vercel
#  (Project → Settings → Environment Variables, or `vercel env add`).
# ─────────────────────────────────────────────────────────────

# X (Twitter) API v2 Bearer Token — https://developer.x.com
# Leave empty to run on mock data.
X_BEARER_TOKEN=

# Alternative to the Bearer Token: Consumer Keys (API Key / API Key Secret) from the same X app.
# The site exchanges them for a Bearer Token itself.
X_API_KEY=
X_API_SECRET=

# Weir (https://weirapp.io) — third-party X data API with free monthly credits. Takes priority over X_BEARER_TOKEN.
WEIR_API_KEY=
# Failover keys: if the key above runs out of credits (HTTP 402), is rejected or rate-limited, the next one
# is used automatically. Both vars accept comma-separated lists, e.g. WEIR_API_KEYS=key2,key3.
# A second free Weir account (5 000 credits / month each) keeps the site live when the first is spent.
WEIR_API_KEYS=
# Max posts fetched per search (two searches per scan; 1 credit per post + 1 per call).
WEIR_MAX_POSTS=40

# "recent" (last 7 days, Basic plan) or "all" (full archive, Pro/Enterprise)
X_SEARCH_SCOPE=recent

# Pages of 100 posts fetched per search (1–5). X bills per post returned → keep at 1 to save credits.
X_MAX_PAGES=1

# (Battlegrounds leaderboard is read from the game's public /api/cup/board — nothing to configure.)

# Force mock data even if tokens are present: "mock" | "" (auto)
VIBE_DATA_MODE=
